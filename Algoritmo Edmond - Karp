from collections import deque

def bfs(capacidade, fluxo, origem, destino, pai):
    n = len(capacidade)
    visitado = [False] * n
    fila = deque([origem])
    visitado[origem] = True

    while fila:
        u = fila.popleft()

        for v in range(n):
            if not visitado[v] and capacidade[u][v] - fluxo[u][v] > 0:
                fila.append(v)
                visitado[v] = True
                pai[v] = u

                if v == destino:
                    return True
    return False


def edmonds_karp(capacidade, origem, destino):
    n = len(capacidade)
    fluxo = [[0]*n for _ in range(n)]
    pai = [-1]*n
    fluxo_maximo = 0

    while bfs(capacidade, fluxo, origem, destino, pai):
        # achar gargalo
        caminho_fluxo = float('inf')
        v = destino

        while v != origem:
            u = pai[v]
            caminho_fluxo = min(caminho_fluxo, capacidade[u][v] - fluxo[u][v])
            v = u

      
        v = destino
        while v != origem:
            u = pai[v]
            fluxo[u][v] += caminho_fluxo
            fluxo[v][u] -= caminho_fluxo
            v = u

        fluxo_maximo += caminho_fluxo

    return fluxo_maximo
