import numpy as np

def ler_matriz():
    n = int(input("Digite o número de vértices: "))
    print("Digite a matriz de adjacência linha por linha:")

    A = []
    for i in range(n):
        linha = list(map(int, input().split()))
        A.append(linha)

    return A


def numero_arvores(A):
    A = np.array(A)

   
    D = np.diag(A.sum(axis=1))
    L = D - A

 
    L_reduzida = L[1:, 1:]

    return round(np.linalg.det(L_reduzida))


A = ler_matriz()

resultado = numero_arvores(A)

print("Número de árvores geradoras:", resultado)
